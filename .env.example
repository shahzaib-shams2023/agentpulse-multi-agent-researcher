# AgentPulse Environment Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# LLM Provider Configuration (OpenAI, Groq, Ollama, OpenRouter)
# When LLM_API_KEY is empty, the application runs seamlessly in offline simulation mode
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Search Configuration
MAX_SEARCH_RESULTS=5
MAX_RESEARCH_STEPS=4

